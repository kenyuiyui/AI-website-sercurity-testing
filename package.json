{
  "name": "ai-website-security-testing",
  "private": true,
  "description": "純前端靜態資安檢查工具：貼上 AI 產出的程式碼，掃描常見資安問題",
  "license": "MIT",
  "scripts": {
    "verify": "node scripts/verify.js",
    "test": "cd eval && node run_rule_regression.js && node -e \"require('./load-ast');require('./run_rule_regression.js');\"",
    "test:ui": "node scripts/ui-smoke.js",
    "eval": "cd eval && node run_scaled_eval.js",
    "eval:ast": "cd eval && node -e \"require('./load-ast');require('./run_scaled_eval.js');\"",
    "eval:fp": "cd eval && node run_fp_eval.js",
    "stamp": "node scripts/stamp-version.js",
    "build:single": "node scripts/stamp-version.js && node scripts/build-single.js",
    "check:single": "node scripts/build-single.js --check"
  }
}
